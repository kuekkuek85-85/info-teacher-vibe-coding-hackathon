rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 읽기 전용 데이터. 쓰기는 전부 서버(admin SDK)에서만 한다.
    match /roster/{name}   { allow read: if request.auth != null; allow write: if false; }
    match /missions/{id}   { allow read: if request.auth != null; allow write: if false; }
    match /config/{doc}    { allow read: if request.auth != null; allow write: if false; }

    // 개인별 코드는 더 쓰지 않는다. 수업 코드는 서버 환경 변수에만 있다.
    // 예전 문서가 남아 있어도 아무도 읽지 못하게 막아 둔다.
    match /codes/{name}    { allow read, write: if false; }

    // 튜터 사용 기록. 서버만 세고 지운다. 클라이언트가 지우면 제한이 무의미하다.
    match /tutorUsage/{name} { allow read, write: if false; }

    match /progress/{name} {
      allow read: if request.auth != null;
      allow create: if false;  // 생성은 /api/enter 에서만

      // 잠긴 미션에 쓰는 것은 화면에서만 막는다. 규칙에서는 missions 맵 안의
      // 어느 미션이 바뀌었는지 특정할 수 없어 검증하지 못한다.
      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.name == resource.data.name
        && request.resource.data.school == resource.data.school
        && request.resource.data.role == resource.data.role
        && request.resource.data.missions is map
        && request.resource.data.missions.keys().size() <= 20
        && request.resource.data.currentStep is string
        && request.resource.data.stuck is bool
        // 발표용 README. 문서 하나 분량을 넘지 않게 묶어 둔다.
        && (!('readmeDraft' in request.resource.data)
            || (request.resource.data.readmeDraft is string
                && request.resource.data.readmeDraft.size() <= 20000))
        && (!('readmePushed' in request.resource.data)
            || request.resource.data.readmePushed is bool)
        // 제출 시각은 서버 시계만 쓴다. 앞당겨 적어 발표 순서를 당길 수 없다.
        // 값을 그대로 들고 가는 저장은 막지 않는다. 막으면 체크 뒤에 아무것도 못 쓴다.
        && (!('readmePushedAt' in request.resource.data)
            || request.resource.data.readmePushedAt
               == resource.data.get('readmePushedAt', null)
            || request.resource.data.readmePushedAt == null
            || request.resource.data.readmePushedAt == request.time)
        && (!('reviewTarget' in request.resource.data)
            || request.resource.data.reviewTarget == resource.data.get('reviewTarget', ''));
    }

    match /reviews/{id} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && id == request.resource.data.reviewer + '_' + request.resource.data.target
        && get(/databases/$(database)/documents/progress/$(request.resource.data.reviewer)).data.ownerUid == request.auth.uid
        && request.resource.data.target
           == get(/databases/$(database)/documents/progress/$(request.resource.data.reviewer)).data.reviewTarget
        // 구조와 길이를 묶어 둔다
        && request.resource.data.keys().hasOnly(
             ['reviewer', 'target', 'checklist', 'comment', 'createdAt'])
        && request.resource.data.checklist is map
        && request.resource.data.checklist.keys().hasOnly(
             ['mvp_one_sentence', 'morning_only', 'concrete_failure',
              'wireframe_imaginable', 'want_to_use'])
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000;
      allow delete: if false;
    }
  }
}
