# Firebase 웹 앱 설정 (Firebase 콘솔 > 프로젝트 설정 > 내 앱)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 서비스 계정 (Firebase 콘솔 > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성)
# PRIVATE_KEY 는 줄바꿈을 \n 으로 바꿔 한 줄로 넣습니다.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# 운영자 대시보드 PIN
TEACHER_PIN=

# 참가자 전원이 함께 쓰는 수업 코드. 워크숍마다 새로 정합니다.
WORKSHOP_CODE=

# AI 튜터 (Google AI Studio 에서 발급). 비워 두면 튜터 버튼이 안내만 냅니다.
GEMINI_API_KEY=
# 비워 두면 gemini-3.1-flash-lite 부터 차례로 시도합니다. 특정 모델을 앞세울 때만 적습니다.
GEMINI_MODEL=

# 학생이 홀수일 때 짝 없는 한 명을 검토할 계정 (roster 에 있는 이름과 같아야 합니다)
# 이 계정은 role 이 staff 라서 짝짓기 대상에 들어가지 않습니다.
FALLBACK_REVIEWER_NAME=홍길동
